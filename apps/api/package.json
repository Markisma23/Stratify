{
  "name": "@stratify/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/tests/**/*.test.ts",
    "jobs:outbox": "tsx src/jobs/runOutboxWorker.ts",
    "jobs:ingestion": "tsx src/jobs/runIngestionWorker.ts",
    "test:integration": "tsx --test src/tests/integration/**/*.test.ts",
    "test:security": "tsx --test src/tests/security/**/*.test.ts",
    "test:e2e": "tsx --test src/tests/e2e/**/*.test.ts",
    "test:uat": "echo \"Run BDD/UAT suite in CI environment\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "jose": "^5.9.3",
    "@node-saml/node-saml": "^5.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
